<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121418"
    android:padding="12dp">

    <!-- Top MPPS Header & Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1B2028"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MPPS v18 Mobile"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProtocolBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="K-Line ISO 14230"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#0A202A"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Vehicle Selector Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1F26"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle: Volkswagen -> Golf V -> 1.9 TDI BLS (Bosch EDC16U34)"
            android:textColor="#90A4AE"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvUsbStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● USB Кабель не підключено"
            android:textColor="#FF5252"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ECU ID & Active File Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvEcuId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ECU ID: Натисніть [ECU ID] для вичитки"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvFileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File: 03G906021QJ_stage1_refined_CS_OK.bin (2 097 152b)"
            android:textColor="#69F0AE"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action Buttons Grid (MPPS Style) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnEcuId"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="ECU ID"
            android:textSize="12sp"
            android:backgroundTint="#263238"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRead"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="READ ECU"
            android:textSize="12sp"
            android:backgroundTint="#00695C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnWrite"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="WRITE FLASH"
            android:textSize="12sp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRecovery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="RECOVERY"
            android:textSize="12sp"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnClearDtc"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="CLEAR DTC"
            android:textSize="12sp"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSelectFile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:text="OPEN FILE..."
            android:textSize="12sp"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF" />
    </GridLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#00E5FF"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Готово до роботи."
        android:textColor="#B0BEC5"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <!-- Terminal Output -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0C0F"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#69F0AE"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="=== MPPS v18 Mobile Engine Started ===
" />
    </ScrollView>
</LinearLayout>
